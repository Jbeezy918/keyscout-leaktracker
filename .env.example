# Optional: raises GitHub API limit from 60/hr to 5000/hr
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional HMAC salt for vault-side fingerprints (public check still uses plain SHA-256)
# LEAKTRACKER_SALT=change-me-to-a-long-random-string

# LEAKTRACKER_DATA=./data
# LEAKTRACKER_DASHBOARD=./dashboard/public
# LEAKTRACKER_DRAFTS=./drafts/reports
# LEAKTRACKER_SECONDS=90
